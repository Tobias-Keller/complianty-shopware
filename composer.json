{
    "name": "complianty/shopware-connector",
    "description": "Shows the Complianty website scan status, starts scans and outputs the approved privacy policy in Shopware 6.",
    "type": "shopware-platform-plugin",
    "license": "GPL-2.0-or-later",
    "version": "0.1.0",
    "homepage": "https://complianty.de",
    "keywords": [
        "shopware",
        "shopware-6",
        "plugin",
        "privacy",
        "gdpr",
        "dsgvo"
    ],
    "authors": [
        {
            "name": "Complianty",
            "homepage": "https://complianty.de"
        }
    ],
    "support": {
        "issues": "https://github.com/Tobias-Keller/complianty-shopware/issues",
        "source": "https://github.com/Tobias-Keller/complianty-shopware"
    },
    "require": {
        "shopware/core": "~6.6.0",
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Complianty\\Connector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Complianty\\Connector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Complianty\\Connector\\CompliantyConnector",
        "label": {
            "de-DE": "Complianty Connector",
            "en-GB": "Complianty Connector"
        },
        "description": {
            "de-DE": "Verbindet den Shop mit Complianty: zeigt den Scan-Status der Website in der Administration, startet Scans und gibt die freigegebene Datenschutzerklärung als Erlebniswelten-Element aus.",
            "en-GB": "Connects your shop to Complianty: shows the website scan status in the Administration, starts scans and outputs the approved privacy policy through a Shopping Experiences element."
        },
        "manufacturerLink": {
            "de-DE": "https://complianty.de/",
            "en-GB": "https://complianty.de/"
        },
        "supportLink": {
            "de-DE": "https://complianty.de/",
            "en-GB": "https://complianty.de/"
        }
    }
}
