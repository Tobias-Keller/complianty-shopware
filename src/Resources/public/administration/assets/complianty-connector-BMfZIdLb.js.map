{% block complianty_connector_page %}
<sw-page class="complianty-connector-page">
    <template #smart-bar-header>
        <h2>{{ $tc('complianty-connector.general.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <mt-button
:disabled="isLoading || !isConnected"
@click="load"
>
            {{ $tc('complianty-connector.status.refresh') }}
        </mt-button>
    </template>

    <template #content>
        <sw-card-view>
            <mt-loader v-if="isLoading" />

            <mt-card
:title="$tc('complianty-connector.connection.title')"
position-identifier="complianty-connection"
>
                <div
class="complianty-summary"
:class="`complianty-summary--${stateClass}`"
>
                    <span
class="complianty-summary__dot"
aria-hidden="true"
></span>
                    <strong class="complianty-summary__label">{{ $tc(`complianty-connector.state.${state}`) }}</strong>
                    <p
v-if="tokenHint"
class="complianty-summary__meta"
>
                        {{ $tc('complianty-connector.connection.token') }}: <code>{{ tokenHint }}</code>
                    </p>
                </div>

                <template v-if="canEdit">
                    <mt-password-field
                        v-model="tokenInput"
                        :label="$tc('complianty-connector.connection.tokenLabel')"
                        :placeholder="$tc('complianty-connector.connection.tokenPlaceholder')"
                        :help-text="$tc('complianty-connector.connection.tokenHelp')"
                        autocomplete="off"
                    />

                    <div class="complianty-actions">
                        <mt-button
                            variant="primary"
                            :disabled="!tokenInput || isSaving"
                            :is-loading="isSaving"
                            @click="connect"
                        >
                            {{ $tc(isConnected ? 'complianty-connector.connection.replace' : 'complianty-connector.connection.connect') }}
                        </mt-button>

                        <mt-button
v-if="isConnected"
:disabled="isSaving"
@click="disconnect"
>
                            {{ $tc('complianty-connector.connection.disconnect') }}
                        </mt-button>
                    </div>
                </template>
            </mt-card>

            <mt-card
                v-if="status"
                :title="$tc('complianty-connector.status.title')"
                position-identifier="complianty-status"
            >
                <div
class="complianty-summary"
:class="`complianty-summary--${statusClass}`"
>
                    <span
class="complianty-summary__dot"
aria-hidden="true"
></span>
                    <strong class="complianty-summary__label">
                        {{ $tc(`complianty-connector.status.overall.${status.status}`) }}
                    </strong>

                    <div class="complianty-pills">
                        <span class="complianty-pill complianty-pill--critical">
                            {{ $tc('complianty-connector.status.pillCritical', status.open_critical, { count: status.open_critical }) }}
                        </span>
                        <span class="complianty-pill complianty-pill--important">
                            {{ $tc('complianty-connector.status.pillImportant', status.open_important, { count: status.open_important }) }}
                        </span>
                    </div>

                    <p class="complianty-summary__meta">
                        {{ $tc('complianty-connector.status.lastScan') }}:
                        {{ lastScan || $tc('complianty-connector.status.never') }}
                        <template v-if="status.scan_state !== 'idle'">
                            · {{ $tc(`complianty-connector.status.scan.${status.scan_state}`) }}
                        </template>
                    </p>
                </div>

                <div class="complianty-scan">
                    <mt-button
                        v-if="canStartScan"
                        variant="primary"
                        :disabled="scanBusy"
                        :is-loading="scanBusy"
                        @click="startScan"
                    >
                        {{ $tc('complianty-connector.scan.start') }}
                    </mt-button>
                    <p
v-else-if="status.scan_trigger_allowed !== true"
class="complianty-usage"
>
                        {{ $tc('complianty-connector.scan.notAllowed') }}
                    </p>

                    <div
                        v-if="scanMessage"
                        class="complianty-summary"
                        :class="`complianty-summary--${scanMessageClass}`"
                        role="status"
                        aria-live="polite"
                    >
                        <span
class="complianty-summary__dot"
aria-hidden="true"
></span>
                        <strong class="complianty-summary__label">
                            {{ $tc(`complianty-connector.scanMessage.${scanMessage.key}`, 0, { error: scanMessage.error, wait: scanWaitText }) }}
                        </strong>
                    </div>
                </div>

                <template v-if="status.todos.length">
                    <h4 class="complianty-heading">
{{ $tc('complianty-connector.status.todos') }}
</h4>
                    <ul class="complianty-todos">
                        <li
                            v-for="(todo, index) in status.todos"
                            :key="index"
                            class="complianty-todo"
                            :class="`complianty-todo--${todo.priority}`"
                        >
                            <span
class="complianty-pill"
:class="`complianty-pill--${todo.priority}`"
>
                                {{ $tc(`complianty-connector.priority.${todo.priority}`) }}
                            </span>
                            <strong class="complianty-todo__title">{{ todo.title }}</strong>
                            <span class="complianty-todo__text">{{ todo.text }}</span>
                        </li>
                    </ul>
                </template>
            </mt-card>

            <mt-card
                v-if="isConnected && state !== 'unauthorized'"
                :title="$tc('complianty-connector.dse.title')"
                position-identifier="complianty-dse"
            >
                <div
v-if="dse"
class="complianty-summary"
:class="`complianty-summary--${dseClass}`"
>
                    <span
class="complianty-summary__dot"
aria-hidden="true"
></span>
                    <strong class="complianty-summary__label">{{ $tc(`complianty-connector.dse.state.${dse.state}`) }}</strong>
                    <p class="complianty-summary__meta">
                        <template v-if="dseApproved">
                            {{ $tc('complianty-connector.dse.approvedAt') }}: {{ dseApproved }} ·
                        </template>
                        {{ $tc('complianty-connector.dse.checkedAt') }}: {{ dseChecked }} ·
                        {{ $tc(dse.has_copy ? 'complianty-connector.dse.copyYes' : 'complianty-connector.dse.copyNo') }}
                    </p>
                </div>
                <div
v-else
class="complianty-summary complianty-summary--neutral"
>
                    <span
class="complianty-summary__dot"
aria-hidden="true"
></span>
                    <strong class="complianty-summary__label">{{ $tc('complianty-connector.dse.notFetched') }}</strong>
                </div>

                <p class="complianty-usage">
{{ $tc('complianty-connector.dse.usage') }}
</p>

                <div class="complianty-actions">
                    <mt-button
v-if="canEdit"
:disabled="isSyncing"
:is-loading="isSyncing"
@click="syncDse"
>
                        {{ $tc('complianty-connector.dse.sync') }}
                    </mt-button>
                </div>
            </mt-card>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
