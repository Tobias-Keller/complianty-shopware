{
    "name": "complianty-connector-admin-lint",
    "private": true,
    "description": "Lint tools for the plugin's Administration code. Not part of the plugin: Shopware runs npm install for every package.json it finds inside the plugin's Administration folder, so these tools live here. Versions as in shopware/administration 6.6.",
    "scripts": {
        "lint": "cd ../../src/Resources/app/administration && NODE_PATH=$INIT_CWD/node_modules $INIT_CWD/node_modules/.bin/eslint --resolve-plugins-relative-to $INIT_CWD --max-warnings 0 --ext .js,.html.twig src",
        "lint:fix": "cd ../../src/Resources/app/administration && NODE_PATH=$INIT_CWD/node_modules $INIT_CWD/node_modules/.bin/eslint --resolve-plugins-relative-to $INIT_CWD --fix --ext .js,.html.twig src",
        "lint:scss": "cd ../../src/Resources/app/administration && $INIT_CWD/node_modules/.bin/stylelint --config-basedir $INIT_CWD \"src/**/*.scss\"",
        "lint:scss-fix": "cd ../../src/Resources/app/administration && $INIT_CWD/node_modules/.bin/stylelint --fix --config-basedir $INIT_CWD \"src/**/*.scss\""
    },
    "devDependencies": {
        "@babel/eslint-parser": "7.26.5",
        "@shopware-ag/eslint-config-base": "2.0.0",
        "eslint": "8.57.1",
        "eslint-config-airbnb-base": "15.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-filename-rules": "1.3.1",
        "eslint-plugin-html": "7.1.0",
        "eslint-plugin-import": "2.31.0",
        "eslint-plugin-inclusive-language": "2.2.1",
        "eslint-plugin-plugin-rules": "file:../../../../../vendor/shopware/administration/Resources/app/administration/eslint-rules/plugin-rules",
        "eslint-plugin-promise": "6.6.0",
        "eslint-plugin-sw-core-rules": "file:../../../../../vendor/shopware/administration/Resources/app/administration/eslint-rules/core-rules",
        "eslint-plugin-sw-deprecation-rules": "file:../../../../../vendor/shopware/administration/Resources/app/administration/eslint-rules/deprecation-rules",
        "eslint-plugin-twig-vue": "file:../../../../../vendor/shopware/administration/Resources/app/administration/twigVuePlugin",
        "eslint-plugin-vue": "9.32.0",
        "eslint-plugin-vuejs-accessibility": "2.4.1",
        "postcss-scss": "^4.0.9",
        "requireindex": "~1.1.0",
        "stylelint": "14.16.1",
        "stylelint-config-standard": "26.0.0",
        "stylelint-config-standard-scss": "5.0.0",
        "vue-eslint-parser": "9.4.3"
    }
}
